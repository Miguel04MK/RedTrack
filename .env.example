# ============================================================
#  RedTrack - variables de entorno
#  Copia este fichero a .env y rellena los valores.
#  .env esta en .gitignore: NUNCA subas los valores reales.
# ============================================================

# --- Base de datos -----------------------------------------
POSTGRES_DB=redtrack
POSTGRES_USER=redtrack
POSTGRES_PASSWORD=cambiame

# Puerto por el que se ve Postgres DESDE el host. Dentro de la red de
# compose siempre es 5432. Se usa 5433 porque el 5432 suele estar ocupado
# por un PostgreSQL instalado en el sistema.
POSTGRES_PUERTO_HOST=5433

# Solo lo usa la app cuando se arranca fuera de Docker (IDE o mvn).
# En docker compose lo sobreescribe el propio compose.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/redtrack

# --- Adzuna ------------------------------------------------
# Registro gratuito en https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Telegram ----------------------------------------------
# 1. Habla con @BotFather -> /newbot -> te da el token
# 2. Escribe a tu bot y saca el chat_id de:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Perfil ------------------------------------------------
# El perfil incluido en el repositorio es un ejemplo. Para usar el tuyo
# sin publicarlo, copialo a perfil.local.yaml (que git ignora) y apunta
# aqui. El salario objetivo es el dato que conviene no publicar.
REDTRACK_PERFIL_RUTA=file:./perfil.local.yaml

# --- API ---------------------------------------------------
# Protege POST /api/recolectar y POST /api/resumen. Sin esto, esos dos
# endpoints se deshabilitan. Genera uno largo y aleatorio, por ejemplo:
#   openssl rand -hex 32
REDTRACK_API_TOKEN=

# --- IA local (opcional) -----------------------------------
# En prod (EC2 t2.micro) esto va SIEMPRE a false: no cabe el modelo.
REDTRACK_IA_ACTIVA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2

# --- Perfil de Spring --------------------------------------
SPRING_PROFILES_ACTIVE=local
